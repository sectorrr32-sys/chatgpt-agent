<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#08090c">
<title>SECTOR 32 — Race • Drift • Battle • Play</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800;900&family=Inter:wght@400;600;700;800&display=swap" rel="stylesheet">

<style>
:root{
--b:#08090c;
--p:#12151b;
--l:#2b3039;
--t:#f5f6f7;
--m:#9ca3ad;
--a:#ff3b19;
--g:#25d366
}

*{box-sizing:border-box}
html{scroll-behavior:smooth}

body{
margin:0;
background:var(--b);
color:var(--t);
font-family:Inter,Arial,sans-serif
}

body:before{
content:"";
position:fixed;
inset:0;
pointer-events:none;
opacity:.4;
background:repeating-linear-gradient(
135deg,
transparent 0 24px,
#fff1 25px 26px
);
z-index:-1
}

.wrap{
width:min(1180px,calc(100% - 28px));
margin:auto
}

.top{
position:fixed;
z-index:20;
top:0;
left:0;
right:0;
background:#08090cdd;
backdrop-filter:blur(14px);
border-bottom:1px solid #ffffff12
}

nav{
height:72px;
display:flex;
align-items:center;
justify-content:space-between
}

.brand{
font:900 31px 'Barlow Condensed';
letter-spacing:2px;
color:#fff;
text-decoration:none
}

.brand span,.red{
color:var(--a)
}

button,.btn{
cursor:pointer
}

.hamb{
width:46px;
height:46px;
border:1px solid #454a54;
border-radius:11px;
background:#11141a;
display:grid;
place-items:center
}

.hamb i,.hamb i:before,.hamb i:after{
content:"";
display:block;
width:21px;
height:2px;
background:#fff;
position:relative
}

.hamb i:before{
position:absolute;
top:-7px
}

.hamb i:after{
position:absolute;
top:7px
}

.menu{
position:fixed;
right:14px;
top:82px;
width:300px;
padding:10px;
background:#0e1015;
border:1px solid #333842;
border-radius:15px;
box-shadow:0 20px 70px #000b;
opacity:0;
pointer-events:none;
transform:translateY(-12px);
transition:.2s
}

.menu.open{
opacity:1;
pointer-events:auto;
transform:none
}

.menu a{
display:block;
padding:15px;
color:#fff;
text-decoration:none;
font-weight:800;
border-radius:9px
}

.menu a:hover{
background:#1b1e24;
color:#ff6948
}

.hero{
min-height:760px;
padding-top:72px;
display:flex;
align-items:center;
background:
linear-gradient(90deg,#08090cf5 8%,#08090caa 52%,#08090c22),
url('https://images.unsplash.com/photo-1511919884226-fd3cad34687c?auto=format&fit=crop&w=1800&q=85')
center/cover
}

.ey{
font-size:12px;
letter-spacing:3px;
color:#ff6948;
font-weight:800
}

.hero h1{
font:900 clamp(80px,14vw,165px)/.8 'Barlow Condensed';
letter-spacing:-3px;
margin:18px 0
}

.tag{
font:700 clamp(21px,3vw,38px) 'Barlow Condensed';
letter-spacing:4px
}

.lead{
max-width:620px;
color:#c4c8ce;
line-height:1.7
}

.actions{
display:flex;
gap:10px;
flex-wrap:wrap;
margin-top:25px
}

.btn{
display:inline-flex;
align-items:center;
justify-content:center;
padding:14px 20px;
border-radius:10px;
border:1px solid #3b404a;
color:#fff;
text-decoration:none;
font-weight:800
}

.primary{
background:var(--a);
border-color:var(--a)
}

.ghost:hover{
background:#171a20
}

.section{
padding:85px 0
}

.alt{
background:#0b0d11;
border-block:1px solid #191c22
}

.head{
display:flex;
justify-content:space-between;
gap:25px;
align-items:end;
margin-bottom:30px
}

.k{
font-size:12px;
letter-spacing:2px;
color:#ff6948;
font-weight:800
}

.title{
font:800 56px/.9 'Barlow Condensed';
text-transform:uppercase;
margin:8px 0
}

.sub{
color:var(--m);
line-height:1.65;
max-width:600px
}

.grid{
display:grid;
grid-template-columns:repeat(3,1fr);
gap:15px
}

.card,.box{
background:linear-gradient(145deg,#171a20,#0f1116);
border:1px solid var(--l);
border-radius:16px;
padding:24px
}

.card{
min-height:175px
}

.card h3{
font:800 29px 'Barlow Condensed';
text-transform:uppercase;
margin:16px 0 7px
}

.card p{
color:var(--m);
line-height:1.55;
margin:0
}

.num{
color:#ff6948;
font:700 17px 'Barlow Condensed'
}

.price{
font:800 34px 'Barlow Condensed';
margin-top:17px
}

.hours{
display:grid;
grid-template-columns:1fr 1fr;
gap:12px
}

.day{
display:flex;
justify-content:space-between;
gap:15px;
padding:18px;
background:#12151a;
border:1px solid var(--l);
border-radius:11px
}

.day span{
color:#ffad8e;
font-weight:700
}

.why,.loc{
display:grid;
grid-template-columns:1.1fr .9fr;
gap:18px
}

.list{
display:grid;
gap:11px
}

.item{
padding:17px;
border:1px solid var(--l);
border-radius:11px;
background:#111318
}

.item span{
display:block;
color:var(--m);
font-size:14px;
margin-top:5px
}

.map{
min-height:350px;
border-radius:17px;
border:1px solid var(--l);
background:
linear-gradient(#08090cb5,#08090cb5),
url('https://images.unsplash.com/photo-1524666041070-9b8767b638ec?auto=format&fit=crop&w=1200&q=75')
center/cover;
display:grid;
place-items:center;
font:800 43px 'Barlow Condensed';
letter-spacing:2px
}

.contactline{
padding:15px 0;
border-bottom:1px solid #252932
}

.contactline:last-child{
border:0
}

.contactline small{
display:block;
color:#858c96;
margin-bottom:6px
}

.contactline a{
color:#fff;
text-decoration:none;
font-size:18px;
font-weight:700
}

.form{
max-width:850px;
margin:auto
}

.fields{
display:grid;
grid-template-columns:1fr 1fr;
gap:13px
}

.field{
display:grid;
gap:7px
}

.full{
grid-column:1/-1
}

.field label{
font-size:12px;
color:#a5abb4;
font-weight:700
}

.field input,
.field select,
.field textarea{
width:100%;
padding:14px;
border:1px solid #30353e;
border-radius:10px;
background:#0d1015;
color:#fff;
font:inherit
}

.field textarea{
min-height:100px
}

.success{
display:none;
padding:17px;
background:#102018;
border:1px solid #3d5147;
border-radius:11px;
color:#b9e8ca;
font-weight:700;
margin-bottom:15px
}

.success.show{
display:block
}

.wa{
position:fixed;
z-index:15;
right:15px;
bottom:15px;
padding:13px 17px;
background:var(--g);
color:#061b0d;
border-radius:99px;
text-decoration:none;
font-weight:900;
box-shadow:0 12px 35px #0009
}

footer{
padding:40px 0;
border-top:1px solid #252932;
color:#858c96
}

.foot{
display:flex;
justify-content:space-between;
gap:20px;
flex-wrap:wrap
}

@media(max-width:800px){
.grid{
grid-template-columns:1fr 1fr
}

.why,.loc{
grid-template-columns:1fr
}

.hours{
grid-template-columns:1fr
}

.title{
font-size:48px
}
}

@media(max-width:560px){
.grid,.fields{
grid-template-columns:1fr
