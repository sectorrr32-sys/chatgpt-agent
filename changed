<script>

const m=document.getElementById('menu');

function toggleMenu(){
m.classList.toggle('open')
}

m.querySelectorAll('a').forEach(a=>
a.onclick=()=>m.classList.remove('open')
);

function book(e){

e.preventDefault();

document
.getElementById('success')
.classList.add('show');

e.target.reset();

document
.getElementById('success')
.scrollIntoView({
behavior:'smooth',
block:'center'
});

}

</script>

